# Copy to .env for local development. Set the same variables in Netlify → Site configuration → Environment variables.

# Supabase (Project Settings → API)
NUXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable (anon) key: safe for the browser
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_xxx
# Secret (service role) key: server only, never exposed to the client
NUXT_SUPABASE_SECRET_KEY=sb_secret_xxx

# Resend (https://resend.com): sends each contact request to contacto@operanta.com.co
NUXT_RESEND_API_KEY=re_xxx
# Sender on a domain verified in Resend
NUXT_CONTACT_FROM_EMAIL="Operanta Web <web@operanta.com.co>"
NUXT_CONTACT_TO_EMAIL=contacto@operanta.com.co

# Google Analytics 4 (optional; analytics stays off when empty)
NUXT_PUBLIC_GTAG_ID=
